rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // ============================
    // Gallery Images
    // ============================
    match /gallery/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Teacher Photos
    // ============================
    match /teachers/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Student Photos
    // ============================
    match /students/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Events Images
    // ============================
    match /events/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Website Assets
    // ============================
    match /website/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Documents (PDF)
    // ============================
    match /documents/{allPaths=**} {

      allow read: if true;

      allow write: if request.auth != null;

    }

    // ============================
    // Default
    // ============================
    match /{allPaths=**} {

      allow read: if true;

      allow write: if false;

    }

  }

}
